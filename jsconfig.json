{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "paths": {
      "@context/*":    ["./src/context/*"],
      "@services/*":   ["./src/services/*"],
      "@assets/*":     ["./src/assets/*"],
      "@components/*": ["./src/components/*"],
      "@hooks/*":      ["./src/hooks/*"],
      "@pages/*":      ["./src/pages/*"],
      "@utils/*":      ["./src/utils/*"],
      "@constants/*":  ["./src/constants/*"],
      "@config/*":     ["./src/config/*"],
      "@style/*":      ["./src/style/*"],
      "@/*":           ["./src/*"]
    }
  },
  "include": ["src/**/*", "vite.config.js"],
  "exclude": ["node_modules", "dist"]
}
